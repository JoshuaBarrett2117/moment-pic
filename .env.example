# 首次启动必须设置（1-128 个字符，不限复杂度）；之后以页面上修改的密码为准
ADMIN_PASSWORD=
# 忘记密码时设为 true 重启一次，用 ADMIN_PASSWORD 重置管理员密码，然后删掉
# ADMIN_PASSWORD_RESET=true

HOST=0.0.0.0
# Docker / 生产默认 3210；本地开发时服务端用 3211，由 Vite（3210）代理
PORT=3211
# 图库目录，多个用逗号/分号/换行分隔
LIBRARY_ROOTS=./samples/library
CACHE_DIR=./data/cache
SQLITE_PATH=./data/gallery.sqlite
PUBLIC_DIR=./dist/public
TRUSTED_PROXIES=
WS_ALLOWED_ORIGINS=
# 可选：智能归纳 AI Token（优先于页面中保存的值）
AI_API_TOKEN=
LOG_LEVEL=info
