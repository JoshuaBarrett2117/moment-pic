HOST=0.0.0.0
PORT=3210
LIBRARY_ROOTS=/data/library
CACHE_DIR=/data/cache
SQLITE_PATH=/data/gallery.sqlite
INDEX_FILE_PATH=/data/index.json
DATABASE_URL=file:/data/gallery.sqlite
LOG_LEVEL=info

# Docker 部署配置示例
# Linux 上部署时，需要配置以下环境变量：
#
# 1. 创建一个 .env 文件，内容如下：
#    LIBRARY_HOST_PATH=/你的图片目录路径
#
# 2. 如果有多个目录，用换行分隔：
#    LIBRARY_ROOTS=/data/library1
#    /data/library2
#    /data/library3
#
# 3. 启动命令：
#    docker-compose up -d
#
# 4. 查看日志：
#    docker-compose logs -f
#
# 5. 重新扫描：
#    curl -X POST http://localhost:3210/api/v1/scan
