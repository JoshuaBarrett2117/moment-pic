HOST=0.0.0.0
PORT=3210
ADMIN_PASSWORD=admin
LIBRARY_ROOTS=/library/main
CACHE_DIR=/data/cache
SQLITE_PATH=/data/gallery.sqlite
INDEX_FILE_PATH=/data/index.json
DATABASE_URL=file:/data/gallery.sqlite
REDIS_URL=
STORAGE_PROFILE=auto
AUTO_MIGRATE_TO_POSTGRES=true
AUTO_IMPORT_LEGACY_JSON=true
STORAGE_MIGRATION_STRATEGY=fail-fast
PUBLIC_DIR=/app/apps/server/dist/public
LOG_LEVEL=info

# Docker Compose 常用配置
COMPOSE_PROJECT_NAME=moment-pic
CONTAINER_NAME=moment-pic
IMAGE_NAME=moment-pic
IMAGE_TAG=latest
DOCKERFILE_PATH=Dockerfile
APP_PORT=3210
TZ=Asia/Shanghai
NODE_ENV=production
RESTART_POLICY=unless-stopped
APP_DATA_DIR=./data/docker

# 增强模式可选配置
# 规则：
# 1. 未配置 PostgreSQL 与 Redis 时，默认走当前轻量模式
# 2. 配置 PostgreSQL 时，必须同时配置 REDIS_URL
# 3. 启用增强模式后，启动时会自动把当前 SQLite 数据迁移到 PostgreSQL
# 4. 默认迁移策略为 fail-fast，迁移失败会直接阻止服务启动
POSTGRES_DB=moment_pic
POSTGRES_USER=moment_pic
POSTGRES_PASSWORD=moment_pic
POSTGRES_PORT=5432
REDIS_PORT=6379
# DATABASE_URL=postgresql://moment_pic:moment_pic@postgres:5432/moment_pic
# REDIS_URL=redis://redis:6379

# 至少配置一个宿主机图片目录。
# Windows 示例：D:/Pictures
# Linux / macOS 示例：/mnt/photos
LIBRARY_HOST_PATH_1=/你的图片目录路径

# 如需多个目录，请在 docker-compose.yml 中取消对应挂载注释，
# 并把 LIBRARY_ROOTS 改为容器内路径列表，例如：
# LIBRARY_ROOTS=/library/main,/library/secondary,/library/archive
# LIBRARY_HOST_PATH_2=/第二个图片目录路径
# LIBRARY_HOST_PATH_3=/第三个图片目录路径

# 健康检查与日志
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=5
HEALTHCHECK_START_PERIOD=20s
LOG_DRIVER=json-file
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# 资源限制
MEM_LIMIT=2g
CPU_LIMIT=2
STOP_GRACE_PERIOD=20s
