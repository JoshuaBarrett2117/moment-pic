HOST=0.0.0.0
PORT=3210
ADMIN_PASSWORD=admin
LIBRARY_ROOTS=
CACHE_DIR=/data/cache
SQLITE_PATH=/data/gallery.sqlite
INDEX_FILE_PATH=/data/index.json
DATABASE_URL=file:/data/gallery.sqlite
LOG_LEVEL=info
LIBRARY_HOST_PATH=/你的图片目录路径

# Docker 部署配置说明
#
# 1. 创建 .env 文件，配置你的图片目录：
#    LIBRARY_HOST_PATH=/volume1/pt1/瞬间
#
# 2. 支持多个目录（用换行分隔）：
#    LIBRARY_ROOTS=/data/library1
#    /data/library2
#    /data/library3
#    然后在 volumes 中添加对应映射
#
# 3. 启动命令：
#    docker-compose up -d --build
#
# 4. 添加目录后需要重新扫描：
#    curl -X POST http://localhost:3210/api/v1/scan
