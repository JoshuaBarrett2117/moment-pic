generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum SourceType {
  folder
  zip
}

enum ScanStatus {
  ready
  error
}

enum ThumbnailStatus {
  ready
  stale
  error
}

enum SmartAlbumStatus {
  active
  hidden
  review_pending
}

enum SmartAlbumSourceEngine {
  rule
  ai
  manual
}

enum SmartAlbumRuleScope {
  albumName
  sourcePath
  parentPath
  assetFileName
}

enum SmartAlbumRuleMatchMode {
  contains
  equals
  prefix
  suffix
  regex
}

enum SmartAlbumRuleAction {
  assignSmartAlbum
  mergeAlias
  exclude
}

enum SmartAlbumAiMode {
  assist
  auto_low_risk
  full_auto
}

model LibraryRoot {
  id            String   @id @default(cuid())
  path          String   @unique
  name          String
  enabled       Boolean  @default(true)
  lastScannedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  albums        Album[]

  @@map("library_roots")
}

model Album {
  id            String      @id @default(cuid())
  libraryRootId String
  name          String
  sourceType    SourceType
  sourcePath    String      @unique
  sourceMtime   String?
  assetsFingerprint String? @map("assets_fingerprint")
  coverAssetId  String?
  assetCount    Int         @default(0)
  scanStatus    ScanStatus  @default(ready)
  errorMessage  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  libraryRoot   LibraryRoot @relation(fields: [libraryRootId], references: [id], onDelete: Cascade)
  assets        Asset[]
  smartAlbumMembers SmartAlbumMember[]

  @@index([libraryRootId], map: "idx_albums_library_root_id")
  @@index([name], map: "idx_albums_name")
  @@index([sourceType], map: "idx_albums_source_type")
  @@map("albums")
}

model Asset {
  id            String      @id @default(cuid())
  albumId       String
  name          String
  extension     String
  sourceType    SourceType
  sourcePath    String
  relativePath  String?
  zipEntryPath  String?
  sortIndex     Int
  width         Int?
  height        Int?
  sizeBytes     String?
  sourceMtime   String?
  thumbnailKey  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  album         Album       @relation(fields: [albumId], references: [id], onDelete: Cascade)
  thumbnail     Thumbnail?

  @@unique([albumId, sortIndex], map: "uq_assets_album_sort_index")
  @@index([albumId], map: "idx_assets_album_id")
  @@index([albumId, sortIndex], map: "idx_assets_album_id_sort_index")
  @@index([thumbnailKey], map: "idx_assets_thumbnail_key")
  @@map("assets")
}

model Thumbnail {
  id        String          @id @default(cuid())
  assetId   String          @unique
  cacheKey  String          @unique
  format    String
  width     Int
  height    Int
  filePath  String
  status    ThumbnailStatus @default(ready)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  asset     Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("thumbnails")
}

model SystemConfig {
  id               String   @id @default("system_config")
  enablePolling    Boolean  @default(true)
  pollingInterval  Int      @default(60000)
  preloadBefore    Int      @default(2)
  preloadAfter     Int      @default(3)
  albumListItemMinWidthMobile Int  @default(160)
  albumListItemMinWidthDesktop Int @default(300)
  albumDetailItemMinWidthMobile Int @default(160)
  albumDetailItemMinWidthDesktop Int @default(300)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("system_config")
}

model AlbumView {
  id        String   @id @default(cuid())
  albumId   String
  viewedAt  DateTime @default(now())

  @@index([albumId], map: "idx_album_views_album_id")
  @@index([viewedAt], map: "idx_album_views_viewed_at")
  @@map("album_views")
}

model SmartAlbum {
  id            String             @id @default(cuid())
  name          String
  normalizedKey String             @unique
  coverAssetId  String?
  albumCount    Int                @default(0)
  assetCount    Int                @default(0)
  sourceSummary String?
  status        SmartAlbumStatus   @default(active)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  members       SmartAlbumMember[]

  @@index([name], map: "idx_smart_albums_name")
  @@map("smart_albums")
}

model SmartAlbumMember {
  id            String                 @id @default(cuid())
  smartAlbumId  String
  albumId       String
  sourceEngine  SmartAlbumSourceEngine
  matchRecordId String?
  confidence    Float
  isPinned      Boolean                @default(false)
  isExcluded    Boolean                @default(false)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  smartAlbum    SmartAlbum             @relation(fields: [smartAlbumId], references: [id], onDelete: Cascade)
  album         Album                  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([smartAlbumId, albumId], map: "uq_smart_album_members_pair")
  @@index([albumId], map: "idx_smart_album_members_album_id")
  @@map("smart_album_members")
}

model SmartAlbumMatchRecord {
  id               String                 @id @default(cuid())
  albumId          String
  smartAlbumName   String
  normalizedKey    String
  sourceEngine     SmartAlbumSourceEngine
  ruleId           String?
  confidence       Float
  matchedScopesJson String
  matchedTokensJson String
  reason           String
  runId            String
  createdAt        DateTime               @default(now())

  @@index([albumId], map: "idx_smart_album_match_records_album_id")
  @@index([runId], map: "idx_smart_album_match_records_run_id")
  @@map("smart_album_match_records")
}

model SmartAlbumRule {
  id                   String                  @id @default(cuid())
  name                 String
  enabled              Boolean                 @default(true)
  priority             Int                     @default(100)
  scope                SmartAlbumRuleScope
  matchMode            SmartAlbumRuleMatchMode
  patternsJson         String
  normalizeOptionsJson String
  action               SmartAlbumRuleAction
  targetName           String?
  targetNameTemplate   String?
  minAlbumCount        Int                     @default(1)
  minConfidence        Float                   @default(1)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([enabled, priority], map: "idx_smart_album_rules_enabled_priority")
  @@map("smart_album_rules")
}

model SmartAlbumAiConfig {
  id                       String            @id @default("smart_album_ai_config")
  enabled                  Boolean           @default(false)
  mode                     SmartAlbumAiMode  @default(assist)
  provider                 String            @default("openai")
  apiEndpoint              String            @default("https://api.openai.com/v1")
  apiToken                 String?
  apiModel                 String            @default("gpt-4.1-mini")
  minConfidenceAutoApply   Float             @default(0.9)
  minClusterAlbumCount     Int               @default(3)
  maxSuggestionsPerRun     Int               @default(50)
  allowAliasMerge          Boolean           @default(true)
  allowCrossRootGrouping   Boolean           @default(true)
  excludedTokensJson       String            @default("[]")
  preferredScopesJson      String            @default("[\"albumName\",\"sourcePath\"]")
  reviewRequiredBelowConfidence Float        @default(0.9)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@map("smart_album_ai_configs")
}
